<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<TargetFrameworks>$(LatestTargetFramework)</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
	</PropertyGroup>

	<ItemGroup>
		<!-- Blazor apps run on Mono, so both edges to linq2db need the build without runtime-async. -->
		<ProjectReference Include="..\..\..\..\Source\LinqToDB.Remote.SignalR.Client\LinqToDB.Remote.SignalR.Client.csproj" AdditionalProperties="BrowserWasmAssetBuild=true" />
		<ProjectReference Update="..\..\..\..\Source\LinqToDB\LinqToDB.csproj" AdditionalProperties="BrowserWasmAssetBuild=true" />

		<PackageReference Include="Octonica.ClickHouseClient" />
		<PackageReference Include="ClickHouse.Driver" />
		<PackageReference Include="MySqlConnector" />
		<PackageReference Include="Net.IBM.Data.Db2" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="AdoNetCore.AseClient" />

		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" />
	</ItemGroup>
</Project>
