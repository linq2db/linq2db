[*.cs]
dotnet_analyzer_diagnostic.severity = none

# nobody asked for this analyzer to trigger in tests...
dotnet_public_api_analyzer.require_api_files = false
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none
dotnet_diagnostic.RS0037.severity = none

# examples are applications, not libraries
dotnet_diagnostic.CA2007.severity = none # CA2007: Do not directly await a Task
dotnet_diagnostic.MA0004.severity = none # MA0004: Use Task.ConfigureAwait
