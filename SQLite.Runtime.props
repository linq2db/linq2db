<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
	Native SQLite deployment for .NET Framework.

	Both SQLite clients are SQLitePCLRaw-based - System.Data.SQLite 2.x DllImports e_sqlite3 and honours
	PreLoadSQLite_BaseDirectory just as Microsoft.Data.Sqlite does - so they share one native package,
	SQLitePCLRaw.lib.e_sqlite3, and one deployment path. (Until 6.5.0 System.Data.SQLite was fed a second
	native package, SourceGear.sqlite3, and this file relocated one of the two because both place
	e_sqlite3 at the same relative path.)

	What is left here is a .NET Framework gap, not a conflict: the package's lowest netfx asset group is
	net471, so a net462 project gets no natives from it at all and they have to be copied by hand. Its
	netfx targets are also Platform-conditioned (x86/x64/arm64) and error out on AnyCPU, which the
	CheckForAnyCPU override below disables for the LINQPad 5 driver.
	-->

	<!--override (disable) the package's AnyCPU guard-->
	<Target Name="CheckForAnyCPU" BeforeTargets="BeforeBuild" Condition="$(TargetFramework) == 'net472'" />

	<!--net462 has no asset group in the package, so copy the supported Windows natives by hand-->
	<Target Name="CopySQLiteRuntimes" AfterTargets="PostBuildEvent" Condition="'$(TargetFramework)' == 'net462'">
		<Copy SourceFiles="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x86\native\e_sqlite3.dll"   DestinationFiles="$(TargetDir)\runtimes\win-x86\native\e_sqlite3.dll" />
		<Copy SourceFiles="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll"   DestinationFiles="$(TargetDir)\runtimes\win-x64\native\e_sqlite3.dll" />
		<Copy SourceFiles="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-arm64\native\e_sqlite3.dll" DestinationFiles="$(TargetDir)\runtimes\win-arm64\native\e_sqlite3.dll" />
	</Target>

	<!--
	net472 is the LINQPad 5 driver. Its two Windows natives are copied by LinqToDB.LINQPad.csproj's
	PostBuild2 target instead, which also owns Pack.cmd and so can guarantee they exist before the
	archive is written - a target hooked on AfterTargets="PostBuildEvent" here has no guaranteed order
	relative to that one.
	-->

</Project>
