<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="Tests.EntityFrameworkCore.props" />

	<PropertyGroup>
		<TargetFrameworks>net11.0</TargetFrameworks>
		<!--EF_MYSQL is absent: see the PackageReference Remove below-->
		<DefineConstants>EF11;EF10_OR_GREATER;EF_FSHARP;$(DefineConstants)</DefineConstants>
		<!--NU1608 is the out-of-constraint resolution the two EF pins below deliberately perform-->
		<NoWarn>$(NoWarn);NU1608</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\LinqToDB.EntityFrameworkCore\LinqToDB.EntityFrameworkCore.EF11.csproj" />
		<ProjectReference Include="..\EntityFrameworkCore.FSharp\Tests.EntityFrameworkCore.FSharp.EF11.fsproj" />
		<!--FSharpTests.cs uses the package's own types, and a ProjectReference does not flow them-->
		<PackageReference Include="EntityFrameworkCore.FSharp" />
		<!--neither Pomelo nor the Microting fork has an EF Core 11 release, so this leg runs without the
		    MySQL EF provider - EF_MYSQL guards the three call sites. The ADO driver itself has no such gap
		    and TestBase builds connection strings with it, so it is referenced directly instead of guarded.-->
		<PackageReference Remove="Pomelo.EntityFrameworkCore.MySql" />
		<PackageReference Include="MySqlConnector" />
		<!--Npgsql's 11.0.0-rc.1.1 hard-pins the previous EF release candidate. A direct reference outranks
		    the pin - NuGet reports it as out of constraint, not a conflict - so these two lines and the NoWarn
		    above are what make the PostgreSQL EF tests restore. Remove all three once Npgsql ships a release
		    pinning the current band.-->
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
	</ItemGroup>

</Project>
