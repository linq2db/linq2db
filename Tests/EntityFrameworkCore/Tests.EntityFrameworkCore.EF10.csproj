<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="Tests.EntityFrameworkCore.props" />

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<DefineConstants>EF10;EF10_OR_GREATER;EF_MYSQL;EF_FSHARP;$(DefineConstants)</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\LinqToDB.EntityFrameworkCore\LinqToDB.EntityFrameworkCore.EF10.csproj" />
		<ProjectReference Include="..\EntityFrameworkCore.FSharp\Tests.EntityFrameworkCore.FSharp.EF10.fsproj" />
		<!--FSharpTests.cs uses the package's own types, and a ProjectReference does not flow them-->
		<PackageReference Include="EntityFrameworkCore.FSharp" />
		<!--Pomelo has no EF Core 10 release; the Microting fork of it does-->
		<PackageReference Remove="Pomelo.EntityFrameworkCore.MySql" />
		<PackageReference Include="Microting.EntityFrameworkCore.MySql" />
	</ItemGroup>

</Project>
