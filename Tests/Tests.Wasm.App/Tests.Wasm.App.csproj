<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<TargetFramework>$(LatestTargetFramework)</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<UseMonoRuntime Condition="'$(WasmRuntime)' == 'CoreCLR'">false</UseMonoRuntime>
		<UseMonoRuntime Condition="'$(WasmRuntime)' == 'Mono'">true</UseMonoRuntime>

		<OutputType>Exe</OutputType>
		<RootNamespace>Tests.Wasm</RootNamespace>
		<AssemblyName>linq2db.Tests.Wasm.App</AssemblyName>

		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<IsPackable>false</IsPackable>

		<!-- Built only by Tests/Tests.Wasm/publish-wasm-bundles.ps1, one publish per WasmRuntime and WasmBundleMode. -->
		<PublishDir>$(MSBuildThisFileDirectory)..\..\.build\wasm\$(WasmRuntime)\$(WasmBundleMode)\</PublishDir>

		<!-- The harness measures runtime behaviour; trim-analysis cleanliness of linq2db is #6168 / AOT work. -->
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
	</PropertyGroup>

	<!-- The WebAssembly SDK trims every publish, Debug included, unless PublishTrimmed is set explicitly. -->
	<PropertyGroup Condition="'$(WasmBundleMode)' == 'Debug'">
		<PublishTrimmed>false</PublishTrimmed>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<PropertyGroup Condition="'$(WasmBundleMode)' == 'TrimPartial'">
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<PropertyGroup Condition="'$(WasmBundleMode)' == 'TrimFull'">
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<PropertyGroup Condition="'$(WasmBundleMode)' == 'NoReflectionJson'">
		<PublishTrimmed>false</PublishTrimmed>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\LinqToDB.Remote.HttpClient.Client\LinqToDB.Remote.HttpClient.Client.csproj" GlobalPropertiesToRemove="WasmBundleMode;WasmRuntime" />
	</ItemGroup>

	<ItemGroup>
		<!-- Reports through stdout, so the Tests-wide ban on System.Console (RS0030) does not apply. -->
		<AdditionalFiles Remove="..\BannedSymbols.txt" />
	</ItemGroup>

	<Target Name="CheckWasmBundleMode" BeforeTargets="Build" Condition="'$(WasmBundleMode)' != 'Debug' and '$(WasmBundleMode)' != 'TrimPartial' and '$(WasmBundleMode)' != 'TrimFull' and '$(WasmBundleMode)' != 'NoReflectionJson'">
		<Error Text="Unknown WasmBundleMode '$(WasmBundleMode)'. Expected Debug, TrimPartial, TrimFull or NoReflectionJson." />
	</Target>

	<Target Name="CheckWasmRuntime" BeforeTargets="Build" Condition="'$(WasmRuntime)' != 'Mono' and '$(WasmRuntime)' != 'CoreCLR'">
		<Error Text="Unknown WasmRuntime '$(WasmRuntime)'. Expected Mono or CoreCLR." />
	</Target>

</Project>
