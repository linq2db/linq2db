		<Compile Include="JoinTest.fs" />
		<Compile Include="RecordSetterTest.fs" />
		<Compile Include="UpdateTest.fs" />
		<Compile Include="LeftJoinTests.fs" />
		<Compile Include="ExpressionFunctionInCteTest.fs" />
		<Compile Include="OptionRoundtrip.fs" />
		<Compile Include="OptionMappingPrecedence.fs" />
		<Compile Include="OptionTypes.fs" />
		<Compile Include="OptionQueryTests.fs" />
		<Compile Include="DuQueryTests.fs" />
	</ItemGroup>

	<ItemGroup>
