<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<RootNamespace>LinqToDB.LINQPad</RootNamespace>
		<AssemblyName>linq2db.LINQPad</AssemblyName>

		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<TargetFrameworks>net472;net8.0-windows7.0</TargetFrameworks>
		<UseWPF>true</UseWPF>

		<DefineConstants>WITH_ISERIES;$(DefineConstants)</DefineConstants>

		<!--disable DB2 provider arch warnings-->
		<MSBuildWarningsAsMessages>MSB3270</MSBuildWarningsAsMessages>
		<SignAssembly>False</SignAssembly>
		
		<!-- Packing is done via sister `LinqToDB.LINQPad.Pack` csproj -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LinqToDB.Scaffold\LinqToDB.Scaffold.csproj" />

		<PackageReference Include="LINQPad.Reference" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RoslynLinqPadVersion)" />

		<PackageReference Include="FirebirdSql.Data.FirebirdClient" />
		<PackageReference Include="MySqlConnector" />
		<PackageReference Include="AdoNetCore.AseClient" />
		<PackageReference Include="System.Data.SQLite" />
		<PackageReference Include="SourceGear.sqlite3" GeneratePathProperty="true" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="ClickHouse.Driver" />
		<PackageReference Include="linq2db4iSeries" Condition="$(DefineConstants.Contains('WITH_ISERIES'))" />
		<PackageReference Include="Microsoft.SqlServer.Types" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net472'">
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="System.Configuration" />

		<PackageReference Include="System.Threading.Tasks.Extensions" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
		<PackageReference Include="System.Memory" />
		<PackageReference Include="System.Buffers" />

		<PackageReference Include="Oracle.ManagedDataAccess" VersionOverride="$(OracleManagedLinqPadVersion)" />

		<!--PackageReference + Reference belongs to same nuget-->
		<PackageReference Include="IBM.Data.DB.Provider" GeneratePathProperty="true" />
		<Reference Include="IBM.Data.DB2" Condition=" $(PlatformTarget) != 'x86' ">
			<HintPath>$(PkgIBM_Data_DB_Provider)\build\net451\x64\IBM.Data.DB2.dll</HintPath>
		</Reference>
		<Reference Include="IBM.Data.DB2" Condition=" $(PlatformTarget) == 'x86' ">
			<HintPath>$(PkgIBM_Data_DB_Provider)\build\net451\x86\IBM.Data.DB2.DLL</HintPath>
		</Reference>

	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' != 'net472' ">
		<PackageReference Include="System.Data.Odbc" />
		<PackageReference Include="System.Data.OleDb" />
		<PackageReference Include="Oracle.ManagedDataAccess.Core" />
		<PackageReference Include="Net.IBM.Data.Db2" />
		<PackageReference Include="Octonica.ClickHouseClient" />
		<PackageReference Include="DuckDB.NET.Data.Full" />
		<PackageReference Include="Ydb.Sdk" />
	</ItemGroup>

	<ItemGroup>
		<Page Update="UI\Settings\DynamicConnectionTab.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\LinqToDBTab.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\SchemaTab.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\ScaffoldTab.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\UniqueStringListControl.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\SharedConnectionOptions.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\StaticConnectionTab.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\AboutTab.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="UI\Settings\SettingsDialog.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
		</Page>
	</ItemGroup>

	<!-- Generate the LINQPad .lpx/.lpx6 artifacts on build. Set to false to build the driver
	     assembly only (e.g. from LinqToDB.LINQPad.Pack, which packs the NuGet and doesn't need
	     the .lpx, and to avoid coupling `dotnet pack` to 7-Zip / Pack.cmd). -->
	<PropertyGroup>
		<GenerateLpxArtifacts Condition="'$(GenerateLpxArtifacts)' == ''">true</GenerateLpxArtifacts>
	</PropertyGroup>

	<Target Name="PostBuild1" AfterTargets="PostBuildEvent" Condition="'$(TargetFramework)' != 'net472' and '$(GenerateLpxArtifacts)' != 'false'">
		<Exec Command="&quot;$(ProjectDir)\NuGet\Pack.cmd&quot; &quot;$(TargetDir)&quot; lpx6" />
	</Target>

	<Target Name="PostBuild2" AfterTargets="PostBuildEvent" Condition="'$(TargetFramework)' == 'net472'">
		<!--we are trying to deceive DB2 provider here, see UnsafeNativeMethods.DB2Interop.Init() method logic-->
		<Delete Files="$(TargetDir)\IBM.Data.DB2.dll" />
		<MakeDir Directories="$(TargetDir)\IBM.Data.DB2.DLL_provider" />
		<Copy SourceFiles="$(PkgIBM_Data_DB_Provider)\build\net451\x64\IBM.Data.DB2.dll" DestinationFiles="$(TargetDir)\IBM.Data.DB2.DLL_provider\x64\IBM.Data.DB2.dll" />
		<Copy SourceFiles="$(PkgIBM_Data_DB_Provider)\build\net451\x86\IBM.Data.DB2.dll" DestinationFiles="$(TargetDir)\IBM.Data.DB2.DLL_provider\x86\IBM.Data.DB2.dll" />

		<!-- LINQPad 5 runs x86/x64 only, so ship just those natives.
		     Two folders on purpose: runtimes/ is Microsoft.Data.Sqlite's default probing path, while
		     sds/runtimes/ is where System.Data.SQLite looks via PreLoadSQLite_BaseDirectory (set in
		     SQLiteProvider's static ctor) — see SQLite.Runtime.props for why they must stay separate.
		     These copies live here, before Pack.cmd, because targets hooked on AfterTargets=
		     "PostBuildEvent" have no guaranteed order relative to this one: the sds copy in
		     SQLite.Runtime.props could otherwise land after the archive was already written. -->
		<Copy SourceFiles="$(PkgSourceGear_sqlite3)\runtimes\win-x86\native\e_sqlite3.dll" DestinationFiles="$(TargetDir)\runtimes\win-x86\native\e_sqlite3.dll" />
		<Copy SourceFiles="$(PkgSourceGear_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll" DestinationFiles="$(TargetDir)\runtimes\win-x64\native\e_sqlite3.dll" />
		<Copy SourceFiles="$(PkgSourceGear_sqlite3)\runtimes\win-x86\native\e_sqlite3.dll" DestinationFiles="$(TargetDir)\$(SystemDataSqliteRuntimeFolder)\win-x86\native\e_sqlite3.dll" />
		<Copy SourceFiles="$(PkgSourceGear_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll" DestinationFiles="$(TargetDir)\$(SystemDataSqliteRuntimeFolder)\win-x64\native\e_sqlite3.dll" />

		<!-- Drop architectures LINQPad 5 can't run; the SDK copies the full win-* set automatically. -->
		<RemoveDir Directories="$(TargetDir)\runtimes\win-arm;$(TargetDir)\runtimes\win-arm64" />

		<Exec Command="&quot;$(ProjectDir)\NuGet\Pack.cmd&quot; &quot;$(TargetDir)&quot; lpx" Condition="'$(GenerateLpxArtifacts)' != 'false'" />
	</Target>

	<!-- Provider packages are not static dependencies of the driver nuget: LINQPad provisions them per connection
	     via DataContextDriver.OverrideDriverDependencies, so driver code needs their ids and versions. Versions are
	     generated from central package management instead of being duplicated in code, where they would drift. -->
	<Target Name="GenerateNuGetPackageVersions" BeforeTargets="BeforeCompile" Condition="'$(TargetFramework)' != 'net472'">
		<PropertyGroup>
			<_NuGetPackageVersionsFile>$(IntermediateOutputPath)NuGetPackageVersions.g.cs</_NuGetPackageVersionsFile>
		</PropertyGroup>

		<!-- built as a single property: an item Include cannot mix literal text with an item reference (MSB4012),
		     and %3B keeps the C# statement separators from splitting the value into several items -->
		<PropertyGroup>
			<_NuGetPackageVersionsSource>
// &lt;auto-generated /&gt;
namespace LinqToDB.LINQPad%3B

internal static class NuGetPackageVersions
{
	public const string AdoNetCore_AseClient                = "@(PackageVersion->WithMetadataValue('Identity', 'AdoNetCore.AseClient')->'%(Version)')"%3B
	public const string ClickHouse_Driver                   = "@(PackageVersion->WithMetadataValue('Identity', 'ClickHouse.Driver')->'%(Version)')"%3B
	public const string dotMorten_Microsoft_SqlServer_Types = "@(PackageVersion->WithMetadataValue('Identity', 'dotMorten.Microsoft.SqlServer.Types')->'%(Version)')"%3B
	public const string DuckDB_NET_Data_Full                = "@(PackageVersion->WithMetadataValue('Identity', 'DuckDB.NET.Data.Full')->'%(Version)')"%3B
	public const string FirebirdSql_Data_FirebirdClient     = "@(PackageVersion->WithMetadataValue('Identity', 'FirebirdSql.Data.FirebirdClient')->'%(Version)')"%3B
	public const string Microsoft_Data_SqlClient            = "@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Data.SqlClient')->'%(Version)')"%3B
	public const string Microsoft_Data_Sqlite               = "@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Data.Sqlite')->'%(Version)')"%3B
	public const string Microsoft_SqlServer_Types           = "@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.SqlServer.Types')->'%(Version)')"%3B
	public const string MySqlConnector                      = "@(PackageVersion->WithMetadataValue('Identity', 'MySqlConnector')->'%(Version)')"%3B
	public const string Net_IBM_Data_Db2                    = "@(PackageVersion->WithMetadataValue('Identity', 'Net.IBM.Data.Db2')->'%(Version)')"%3B
	public const string Net_IBM_Data_Db2_lnx                = "@(PackageVersion->WithMetadataValue('Identity', 'Net.IBM.Data.Db2-lnx')->'%(Version)')"%3B
	public const string Net_IBM_Data_Db2_osx                = "@(PackageVersion->WithMetadataValue('Identity', 'Net.IBM.Data.Db2-osx')->'%(Version)')"%3B
	public const string Npgsql                              = "@(PackageVersion->WithMetadataValue('Identity', 'Npgsql')->'%(Version)')"%3B
	public const string Octonica_ClickHouseClient           = "@(PackageVersion->WithMetadataValue('Identity', 'Octonica.ClickHouseClient')->'%(Version)')"%3B
	public const string Oracle_ManagedDataAccess_Core       = "@(PackageVersion->WithMetadataValue('Identity', 'Oracle.ManagedDataAccess.Core')->'%(Version)')"%3B
	public const string SourceGear_sqlite3                  = "@(PackageVersion->WithMetadataValue('Identity', 'SourceGear.sqlite3')->'%(Version)')"%3B
	public const string SQLitePCLRaw_lib_e_sqlite3          = "@(PackageVersion->WithMetadataValue('Identity', 'SQLitePCLRaw.lib.e_sqlite3')->'%(Version)')"%3B
	public const string System_Data_Odbc                    = "@(PackageVersion->WithMetadataValue('Identity', 'System.Data.Odbc')->'%(Version)')"%3B
	public const string System_Data_OleDb                   = "@(PackageVersion->WithMetadataValue('Identity', 'System.Data.OleDb')->'%(Version)')"%3B
	public const string System_Data_SQLite                  = "@(PackageVersion->WithMetadataValue('Identity', 'System.Data.SQLite')->'%(Version)')"%3B
	public const string Ydb_Sdk                             = "@(PackageVersion->WithMetadataValue('Identity', 'Ydb.Sdk')->'%(Version)')"%3B
}
			</_NuGetPackageVersionsSource>
		</PropertyGroup>

		<WriteLinesToFile File="$(_NuGetPackageVersionsFile)" Lines="$(_NuGetPackageVersionsSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<Compile    Include="$(_NuGetPackageVersionsFile)" />
			<FileWrites Include="$(_NuGetPackageVersionsFile)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<Resource Include="..\..\NuGet\icon.png" Link="Resources\Logo.png" />

		<AdditionalFiles Include="PublicAPI/PublicAPI.*.txt" />
		<AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.*.txt" />

		<!-- driver-specific bans, merged with the repo-wide list from Source/Directory.Build.props -->
		<AdditionalFiles Include="BannedSymbols.txt" />
	</ItemGroup>

	<Import Project="$(MSBuildThisFileDirectory)\..\..\SQLite.Runtime.props" />
</Project>
