<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>linq2db.Extensions</AssemblyName>
		<RootNamespace>LinqToDB.Extensions</RootNamespace>

		<IsAotCompatible Condition=" $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) ">true</IsAotCompatible>
		<PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
	</PropertyGroup>
	
	<PropertyGroup Label="Nuget">
		<Title>LINQ to DB Dependency Injection and Logging Extensions</Title>
		<Description>LINQ to DB Extensions adds ability to configure Linq To DB usage with DI container or logger.</Description>
		<Product>$(Title)</Product>

		<PackageTags>$(PackageTags);DI;dependencyinjection;logging;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup Label="Nuget">
		<None Include="readme.md" Pack="true" PackagePath="readme.md" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LinqToDB\LinqToDB.csproj" PrivateAssets="contentfiles;build" />

		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<!--in the shared framework from net11.0 on: https://learn.microsoft.com/dotnet/core/compatibility/extensions/11/extensions-in-shared-framework-->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.*.txt" />
	</ItemGroup>
</Project>
