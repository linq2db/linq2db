<Project>

	<!--Each EF project defines its own EFnn symbol plus every EFnn_OR_GREATER it satisfies. Source uses the
	    _OR_GREATER form for a capability that arrived in a version and stayed, so a new EF version is a token
	    here rather than an edit to every #if. Same convention in Tests.EntityFrameworkCore.props.-->
	<PropertyGroup>
		<AssemblyName>linq2db.EntityFrameworkCore</AssemblyName>
		<RootNamespace>LinqToDB.EntityFrameworkCore</RootNamespace>

		<!--EF1001: use of internal EF API-->
		<NoWarn>EF1001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LinqToDB\LinqToDB.csproj" PrivateAssets="contentfiles;build" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI/PublicAPI.*.txt" />
		<AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.*.txt" />
	</ItemGroup>

</Project>
