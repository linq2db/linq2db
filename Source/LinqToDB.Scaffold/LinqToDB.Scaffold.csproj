<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>linq2db.Scaffold</AssemblyName>
		<RootNamespace>LinqToDB</RootNamespace>

		<!--Same as LinqToDB.csproj: $(BaselineVersion) ships net8.0/net9.0 this package no longer has, so the
		    baseline comparison falls back to netstandard2.0. Remove both once a released baseline drops them.-->
		<DisablePackageBaselineValidation>true</DisablePackageBaselineValidation>
		<ApiCompatPermitUnnecessarySuppressions>true</ApiCompatPermitUnnecessarySuppressions>
	</PropertyGroup>

	<PropertyGroup Label="Nuget">
		<Title>LINQ to DB Scaffold Framework</Title>
		<Description>LINQ to DB Scaffold framework is used for database model generation for Linq To DB projects.</Description>
		<Product>$(Title)</Product>

		<PackageTags>$(PackageTags);Scaffold;T4;cli;RevEng</PackageTags>
	</PropertyGroup>

	<ItemGroup Label="Nuget">
		<None Include="readme.md" Pack="true" PackagePath="readme.md" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LinqToDB.Tools\LinqToDB.Tools.csproj" PrivateAssets="contentfiles;build" />

		<PackageReference Include="Humanizer.Core" />

		<AdditionalFiles Include="PublicAPI/PublicAPI.*.txt" />
		<AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.*.txt" />
	</ItemGroup>

</Project>
