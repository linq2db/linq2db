<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<AssemblyName>linq2db.Remote.HttpClient.Server</AssemblyName>
		<RootNamespace>LinqToDB.Remote.HttpClient.Server</RootNamespace>
		<OutputType>Library</OutputType>

		<TargetFrameworks>$(ToolTargetFrameworks)</TargetFrameworks>
		<TargetFrameworks Condition="'$(Configuration)'=='Testing'">$(LatestTargetFramework)</TargetFrameworks>

		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	
	<PropertyGroup Label="Nuget">
		<Title>LINQ to DB remote data context over HttpClient</Title>
		<Description>LINQ to DB Remote HttpClient package provides server classes to query database remotely using HttpClient.</Description>
		<Product>$(Title)</Product>

		<PackageValidationBaselineVersion>$(RemoteHttpClientServerBaselineVersion)</PackageValidationBaselineVersion>

		<PackageTags>$(PackageTags);HttpClient;RemoteLinq</PackageTags>
	</PropertyGroup>

	<ItemGroup Label="Nuget">
		<None Include="readme.md" Pack="true" PackagePath="readme.md" />
		<!--dropped in 6.6.0 with ToolTargetFrameworks-->
		<PackageValidationBaselineFrameworkToIgnore Include="net8.0;net9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LinqToDB\LinqToDB.csproj" PrivateAssets="contentfiles;build" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.*.txt" />
	</ItemGroup>
</Project>
