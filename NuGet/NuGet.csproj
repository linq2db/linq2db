<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net462</TargetFrameworks>
		<PlatformTarget>x64</PlatformTarget>
		<IsPackable>false</IsPackable>
		<EnablePackageValidation>false</EnablePackageValidation>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Source\LinqToDB.Scaffold\LinqToDB.Scaffold.csproj" />

		<PackageReference Include="System.Data.OleDb" />
		<PackageReference Include="System.Data.Odbc" />
		<PackageReference Include="MySqlConnector" />
		<PackageReference Include="ClickHouse.Driver" />
		<PackageReference Include="AdoNetCore.AseClient" />
		<PackageReference Include="Humanizer.Core" />
		<PackageReference Include="FirebirdSql.Data.FirebirdClient" />
		<PackageReference Include="Oracle.ManagedDataAccess" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="System.Data.SQLite" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" GeneratePathProperty="true" />
		<PackageReference Include="Microsoft.SqlServer.Types" GeneratePathProperty="true" />
		<PackageReference Include="Microsoft.Data.SqlClient" />

		<None Include="..\Data\*">
			<Link>Database/%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<PackageReference Include="Microsoft.SqlServer.Compact" GeneratePathProperty="true" />
		<SqlCeNativeLibs64 Include="$(PkgMicrosoft_SqlServer_Compact)\NativeBinaries\amd64\**" Condition=" $(PlatformTarget) != 'x86' " />
		<None Include="@(SqlCeNativeLibs64)" Condition=" $(PlatformTarget) != 'x86' ">
			<Link>amd64\%(RecursiveDir)%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<SqlCeNativeLibs86 Include="$(PkgMicrosoft_SqlServer_Compact)\NativeBinaries\x86\**" Condition=" $(PlatformTarget) == 'x86' " />
		<None Include="@(SqlCeNativeLibs86)" Condition=" $(PlatformTarget) == 'x86' ">
			<Link>x86\%(RecursiveDir)%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<Reference Include="Sap.Data.Hana.v4.5">
			<HintPath>$(MSBuildThisFileDirectory)..\Redist\SapHana\v4.5\Sap.Data.Hana.v4.5.dll</HintPath>
			<Private>true</Private>
		</Reference>

		<PackageReference Include="IBM.Data.DB.Provider" GeneratePathProperty="true" />
		<Reference Include="IBM.Data.DB2" Condition=" $(PlatformTarget) != 'x86' ">
			<HintPath>$(PkgIBM_Data_DB_Provider)\build\net451\x64\IBM.Data.DB2.dll</HintPath>
		</Reference>
		<Reference Include="IBM.Data.DB2" Condition=" $(PlatformTarget) == 'x86' ">
			<HintPath>$(PkgIBM_Data_DB_Provider)\build\net451\x86\IBM.Data.DB2.dll</HintPath>
		</Reference>
	</ItemGroup>

	<Target Name="CopySQLServerTypes" AfterTargets="PostBuildEvent" Condition="'$(TargetFramework)' == 'net462'">
		<!--copy manually as package contains only net472 copy instructions-->
		<Copy SourceFiles="$(PkgMicrosoft_SqlServer_Types)\runtimes\win-x86\native\SqlServerSpatial170.dll"   DestinationFiles="$(TargetDir)\x86\SqlServerSpatial170.dll" />
		<Copy SourceFiles="$(PkgMicrosoft_SqlServer_Types)\runtimes\win-x64\native\SqlServerSpatial170.dll"   DestinationFiles="$(TargetDir)\x64\SqlServerSpatial170.dll" />
		<Copy SourceFiles="$(PkgMicrosoft_SqlServer_Types)\runtimes\win-arm64\native\SqlServerSpatial170.dll" DestinationFiles="$(TargetDir)\arm64\SqlServerSpatial170.dll" />
	</Target>

	<!-- An unrestored $(PkgMicrosoft_SqlServer_Compact) leaves the native globs empty without any diagnostic. -->
	<Target Name="CheckSqlCeNatives" BeforeTargets="CopyFilesToOutputDirectory">
		<Error Condition=" $(PlatformTarget) != 'x86' and '@(SqlCeNativeLibs64)' == '' " Text="SQL CE native binaries not found under '$(PkgMicrosoft_SqlServer_Compact)\NativeBinaries\amd64' - restore Microsoft.SqlServer.Compact." />
		<Error Condition=" $(PlatformTarget) == 'x86' and '@(SqlCeNativeLibs86)' == '' " Text="SQL CE native binaries not found under '$(PkgMicrosoft_SqlServer_Compact)\NativeBinaries\x86' - restore Microsoft.SqlServer.Compact." />
	</Target>

	<Import Project="$(MSBuildThisFileDirectory)\..\SQLite.Runtime.props" />
</Project>
