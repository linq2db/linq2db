<Project Sdk="Microsoft.Build.NoTargets/3.7.0">
	<!--
	Solution-visibility project only: no code, nothing to compile or pack.
	Globs Docs/ so the documentation sources show up in Solution Explorer.
	-->
	<PropertyGroup>
		<TargetFrameworks />
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<!--docfx metadata output: hundreds of generated yml files after a local docs build-->
		<DefaultItemExcludes>$(DefaultItemExcludes);source/api/**;source/obj/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!--drop everything Directory.Build.props injects (analyzers, polyfills, SourceLink, the Source/Shared Compatibility linkbase) - none of it applies to a docs-only glue project-->
		<PackageReference Remove="@(PackageReference)" />
		<Compile Remove="@(Compile)" />
	</ItemGroup>
</Project>
